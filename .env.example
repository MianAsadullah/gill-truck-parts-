# ─── Database ────────────────────────────────────────────────────────────────
# Local Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gilltruckparts?schema=public"
#
# Supabase (use the pooled connection for the app, direct for migrations):
# DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gilltruckparts?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# HMAC key for session cookies. Generate: openssl rand -base64 48
SESSION_SECRET="change-me-min-32-chars"
